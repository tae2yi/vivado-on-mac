--- /dev/null
+++ b/Sources/USBIPDCore/Protocol/USBIPStreamFramer.swift
@@ -0,0 +1,72 @@
+// USBIPStreamFramer.swift
+// Splits a TCP byte stream into whole USB/IP messages
+
+import Foundation
+
+/// TCP delivers bytes, not messages. The Linux `usbip` client writes op_common and
+/// the import request's busid in two separate sends, so treating each receive as one
+/// message failed every import ("40 bytes required, 8 received", then the busid read
+/// as command 0x3100). This works out how long the next message is, so the caller can
+/// wait until it has all of it.
+public enum USBIPStreamFramer {
+    /// Size of the next complete message at the start of `buffer`, `nil` if more bytes
+    /// are needed to know or to have all of it, or `buffer.count` if the message is
+    /// unrecognisable — passing that to the processor surfaces its usual error.
+    public static func nextFrameLength(in buffer: Data, phase: USBIPConnectionState.Phase) -> Int? {
+        switch phase {
+        case .handshake:
+            return handshakeFrameLength(in: buffer)
+        case .attached:
+            return attachedFrameLength(in: buffer)
+        }
+    }
+
+    /// op_common is version(2) code(2) status(4); OP_REQ_IMPORT adds a 32-byte busid.
+    private static func handshakeFrameLength(in buffer: Data) -> Int? {
+        guard buffer.count >= 8 else { return nil }
+        let code = UInt16(buffer[buffer.startIndex + 2]) << 8 | UInt16(buffer[buffer.startIndex + 3])
+        let length: Int
+        switch USBIPProtocol.Command(rawValue: code) {
+        case .requestDeviceList:
+            length = 8
+        case .requestDeviceImport:
+            length = 8 + 32
+        default:
+            return buffer.count
+        }
+        return buffer.count >= length ? length : nil
+    }
+
+    /// Every CMD_ message has a 48-byte prefix. CMD_SUBMIT OUT carries
+    /// transfer_buffer_length bytes after it, and an isochronous submit is followed by
+    /// 16 bytes per packet descriptor.
+    private static func attachedFrameLength(in buffer: Data) -> Int? {
+        let prefixSize = 48
+        guard buffer.count >= prefixSize else { return nil }
+        var length = prefixSize
+        switch USBIPProtocol.BasicCommand(rawValue: bigEndianUInt32(in: buffer, at: 0)) {
+        case .submit:
+            let direction = bigEndianUInt32(in: buffer, at: 12)
+            let transferBufferLength = bigEndianUInt32(in: buffer, at: 24)
+            let numberOfPackets = bigEndianUInt32(in: buffer, at: 32)
+            if direction == 0 {  // USBIP_DIR_OUT
+                length += Int(transferBufferLength)
+            }
+            // Non-isochronous submits send 0 or 0xffffffff here.
+            if numberOfPackets != 0 && numberOfPackets != 0xFFFF_FFFF {
+                length += Int(numberOfPackets) * 16
+            }
+        case .unlink:
+            break
+        default:
+            return buffer.count
+        }
+        return buffer.count >= length ? length : nil
+    }
+
+    /// Byte by byte, so it neither assumes a zero startIndex nor an aligned address.
+    private static func bigEndianUInt32(in buffer: Data, at offset: Int) -> UInt32 {
+        let start = buffer.startIndex + offset
+        return buffer[start..<start + 4].reduce(0) { $0 << 8 | UInt32($1) }
+    }
+}
