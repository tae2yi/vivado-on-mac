diff --git a/Tests/USBIPDCoreTests/Protocol/USBIPStreamFramerTests.swift b/Tests/USBIPDCoreTests/Protocol/USBIPStreamFramerTests.swift
new file mode 100644
index 0000000..74edad6
--- /dev/null
+++ b/Tests/USBIPDCoreTests/Protocol/USBIPStreamFramerTests.swift
@@ -0,0 +1,73 @@
+import XCTest
+@testable import USBIPDCore
+
+final class USBIPStreamFramerTests: XCTestCase {
+    private func uint32(_ value: UInt32) -> [UInt8] {
+        [UInt8(value >> 24 & 0xFF), UInt8(value >> 16 & 0xFF), UInt8(value >> 8 & 0xFF), UInt8(value & 0xFF)]
+    }
+
+    /// op_common: version 0x0111, code, status 0.
+    private func opCommon(code: UInt16) -> [UInt8] {
+        [0x01, 0x11, UInt8(code >> 8), UInt8(code & 0xFF), 0, 0, 0, 0]
+    }
+
+    /// A 48-byte CMD_SUBMIT prefix.
+    private func submitPrefix(direction: UInt32, transferBufferLength: UInt32, numberOfPackets: UInt32 = 0) -> [UInt8] {
+        var bytes = uint32(1) + uint32(7) + uint32(0x0002_0001) + uint32(direction) + uint32(1)
+        bytes += uint32(0) + uint32(transferBufferLength) + uint32(0) + uint32(numberOfPackets) + uint32(0)
+        bytes += [UInt8](repeating: 0, count: 8)
+        return bytes
+    }
+
+    // The Linux client sends op_common and the busid in separate writes.
+    func testImportRequestWaitsForBusID() {
+        let header = Data(opCommon(code: 0x8003))
+        XCTAssertNil(USBIPStreamFramer.nextFrameLength(in: header, phase: .handshake))
+
+        let whole = header + Data("2-1".utf8) + Data(count: 29)
+        XCTAssertEqual(USBIPStreamFramer.nextFrameLength(in: whole, phase: .handshake), 40)
+    }
+
+    func testDeviceListRequestIsHeaderOnly() {
+        let data = Data(opCommon(code: 0x8005)) + Data([0xAA])
+        XCTAssertEqual(USBIPStreamFramer.nextFrameLength(in: data, phase: .handshake), 8)
+    }
+
+    func testUnknownHandshakeCommandIsPassedThroughWhole() {
+        let data = Data(opCommon(code: 0x1234)) + Data([1, 2, 3])
+        XCTAssertEqual(USBIPStreamFramer.nextFrameLength(in: data, phase: .handshake), 11)
+    }
+
+    func testSubmitOutIncludesTransferBuffer() {
+        let prefix = Data(submitPrefix(direction: 0, transferBufferLength: 100))
+        XCTAssertNil(USBIPStreamFramer.nextFrameLength(in: prefix + Data(count: 99), phase: .attached(busID: "2-1")))
+        XCTAssertEqual(
+            USBIPStreamFramer.nextFrameLength(in: prefix + Data(count: 100 + 48), phase: .attached(busID: "2-1")),
+            148)
+    }
+
+    func testSubmitInHasNoPayload() {
+        let prefix = Data(submitPrefix(direction: 1, transferBufferLength: 512, numberOfPackets: 0xFFFF_FFFF))
+        XCTAssertEqual(USBIPStreamFramer.nextFrameLength(in: prefix, phase: .attached(busID: "2-1")), 48)
+    }
+
+    func testIsochronousSubmitIncludesPacketDescriptors() {
+        let prefix = Data(submitPrefix(direction: 1, transferBufferLength: 512, numberOfPackets: 2))
+        XCTAssertNil(USBIPStreamFramer.nextFrameLength(in: prefix, phase: .attached(busID: "2-1")))
+        XCTAssertEqual(
+            USBIPStreamFramer.nextFrameLength(in: prefix + Data(count: 32), phase: .attached(busID: "2-1")),
+            80)
+    }
+
+    func testUnlinkIsFixedSize() {
+        let unlink = Data(uint32(2) + [UInt8](repeating: 0, count: 44))
+        XCTAssertEqual(USBIPStreamFramer.nextFrameLength(in: unlink, phase: .attached(busID: "2-1")), 48)
+    }
+
+    // A buffer left over from earlier messages does not start at index 0.
+    func testSlicedBufferIsReadFromItsStartIndex() {
+        let bytes = Data([0xFF, 0xFF, 0xFF] + submitPrefix(direction: 0, transferBufferLength: 4) + [1, 2, 3, 4])
+        let slice = bytes.dropFirst(3)
+        XCTAssertEqual(USBIPStreamFramer.nextFrameLength(in: slice, phase: .attached(busID: "2-1")), 52)
+    }
+}
